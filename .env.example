# Local development; docker-compose serves the database and object storage.
# Copy to .env — the server loads it on start.

DATABASE_URL=postgres://golearn:golearn@localhost:5433/golearn?sslmode=disable
PORT=8080

# First admin, created on start
ADMIN_EMAIL=admin@golearn.local
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin

# Object storage (RustFS from docker-compose). Without S3_ENDPOINT the server
# still runs, but icon uploads answer 503 storage_disabled.
S3_ENDPOINT=localhost:9010
S3_BUCKET=golearn
S3_ACCESS_KEY=golearn
S3_SECRET_KEY=golearn123
S3_PUBLIC_URL=http://localhost:9010/golearn

# Lab sandbox. SANDBOX_LOCAL runs each lab in a container on this machine's Docker
# (no sandbox VM, no SSH). Requires the golearn/sandbox* images — see CLAUDE.md.
# SANDBOX_PRIVILEGED additionally enables the Docker and Kubernetes courses, whose
# labs need a container runtime of their own.
SANDBOX_LOCAL=1
SANDBOX_PRIVILEGED=1

# ── Robokassa ───────────────────────────────────────────────────────────────
# Leave empty for development: checkout then uses the stub provider, which needs
# no merchant account and lets the whole flow be exercised locally.
#
# These two passwords are secrets. In production they live in the cluster's
# sealed secret and never in a file like this one.
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# Test mode is ON unless this is explicitly "0" or "false". Turning it off is
# what starts charging real cards.
ROBOKASSA_TEST=1
# Must match the shop's own digest setting, or every signature is rejected.
ROBOKASSA_SHA256=0
