# Local development; docker-compose serves the database and object storage.
# Copy to .env — the server loads it on start.

DATABASE_URL=postgres://golearn:golearn@localhost:5433/golearn?sslmode=disable
PORT=8080

# First admin, created on start
ADMIN_EMAIL=admin@golearn.local
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin

# Object storage (RustFS from docker-compose). Without S3_ENDPOINT the server
# still runs, but icon uploads answer 503 storage_disabled.
S3_ENDPOINT=localhost:9010
S3_BUCKET=golearn
S3_ACCESS_KEY=golearn
S3_SECRET_KEY=golearn123
S3_PUBLIC_URL=http://localhost:9010/golearn
