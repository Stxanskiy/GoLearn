FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
# ── base system + all course CLI tools ──
RUN apt-get update && apt-get install -y --no-install-recommends \
      systemd systemd-sysv dbus \
      docker.io docker-compose-v2 \
      iproute2 iptables kmod \
      openssh-server \
      e2fsprogs ca-certificates \
      curl wget vim nano less jq tree htop tmux git make unzip \
      iputils-ping dnsutils netcat-openbsd \
      zsh bash-completion \
      ansible python3 python3-pip \
 && apt-get clean && rm -rf /var/lib/apt/lists/*
# ── kubectl ──
RUN KV=$(curl -fSL --retry 3 https://dl.k8s.io/release/stable.txt) && \
    curl -fSL --retry 3 "https://dl.k8s.io/release/${KV}/bin/linux/amd64/kubectl" -o /usr/local/bin/kubectl && \
    chmod +x /usr/local/bin/kubectl
# ── helm ──
RUN curl -fSL --retry 3 https://get.helm.sh/helm-v3.16.3-linux-amd64.tar.gz | tar xz -C /tmp && \
    mv /tmp/linux-amd64/helm /usr/local/bin/helm && chmod +x /usr/local/bin/helm && rm -rf /tmp/linux-amd64
# ── k3s ──
RUN curl -fSL --retry 3 "https://github.com/k3s-io/k3s/releases/download/v1.30.6%2Bk3s1/k3s" -o /usr/local/bin/k3s && \
    chmod +x /usr/local/bin/k3s
# ── Gateway API ──
# k3s brings Traefik but neither the CRDs nor the Gateway provider, and the VM has
# no network to fetch them at runtime. Both go where k3s applies manifests on
# startup, so the cluster serves Gateway API from the first boot — enabling the
# provider later would mean a Helm upgrade and a Traefik restart inside a
# one-vCPU VM, which a lesson cannot sensibly wait out.
RUN mkdir -p /var/lib/rancher/k3s/server/manifests && \
    curl -fSL --retry 3 -o /var/lib/rancher/k3s/server/manifests/gateway-api-crds.yaml \
      "https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.2.1/standard-install.yaml" && \
    grep -q 'kind: CustomResourceDefinition' /var/lib/rancher/k3s/server/manifests/gateway-api-crds.yaml
COPY rootfs-extra/traefik-gateway.yaml /var/lib/rancher/k3s/server/manifests/traefik-gateway.yaml
# ── zsh: plugins + config, make it root's shell ──
RUN git clone -q --depth=1 https://github.com/zsh-users/zsh-autosuggestions /usr/share/zsh-plugins/zsh-autosuggestions && \
    git clone -q --depth=1 https://github.com/zsh-users/zsh-syntax-highlighting /usr/share/zsh-plugins/zsh-syntax-highlighting && \
    rm -rf /usr/share/zsh-plugins/*/.git
COPY rootfs-extra/zshrc /root/.zshrc
RUN chsh -s /usr/bin/zsh root
RUN passwd -d root
# ── neovim ───────────────────────────────────────────────────────────────────
# From upstream, not apt: Ubuntu 24.04 ships 0.9.5. Current gitsigns calls the
# 0.11 form of vim.validate, which older Neovim reads as the old one and rejects
# with "opt: expected table, got string" — a stack trace over the student's file
# and two Enters to get past it. 0.10 was not enough; 0.11 is.
RUN curl -fsSL --retry 3 https://github.com/neovim/neovim/releases/download/v0.11.4/nvim-linux-x86_64.tar.gz \
      | tar xz -C /opt && ln -sf /opt/nvim-linux-x86_64/bin/nvim /usr/local/bin/nvim && \
    nvim --version | head -1

# ── neovim: config + plugins baked in, because the VM has no network ──
# A student opening a file must not wait on a request that cannot succeed, so
# lazy.nvim's update checker is off in init.lua and nothing installs at runtime.
COPY rootfs-extra/nvim /root/.config/nvim
RUN git clone -q --depth=1 --branch=stable \
      https://github.com/folke/lazy.nvim /root/.local/share/nvim/lazy/lazy.nvim && \
    mkdir -p /root/.local/state/nvim && \
    nvim --headless "+Lazy! install" +qa > /tmp/lazy.log 2>&1; tail -5 /tmp/lazy.log; \
    # Проверяем результат, а не код возврата. nvim выходит ненулём из-за мелочей
    # уже после успешной установки; и наоборот — первая сборка прошла «успешно»
    # с одним lazy.nvim, потому что конвейер `| tail` подменял статус. Смотрим на
    # то, что реально лежит в образе.
    test "$(ls /root/.local/share/nvim/lazy | wc -l)" -ge 7 && \
    find /root/.local/share/nvim/lazy -name .git -type d -prune -exec rm -rf {} + && \
    printf 'export EDITOR=nvim\nalias vim=nvim\nalias vi=nvim\n' >> /root/.zshrc

# Smoke test. It must LOAD the plugins, not merely start Neovim: lazy.nvim holds
# them until the VeryLazy event, which fires after the UI appears — and there is
# no UI in --headless. The previous version of this test opened a file headless,
# loaded nothing, and passed happily on a config that threw a stack trace at the
# first student who opened one. "Lazy! load all" is what makes it mean anything.
RUN cd /tmp && git init -q smoke && cd smoke && \
    printf 'a: 1\nb: two\n' > smoke.yaml && git add -A && \
    git -c user.email=b@t -c user.name=b commit -qm init && \
    printf 'a: 2\n' >> smoke.yaml && \
    nvim --headless "+Lazy! load all" -c "edit smoke.yaml" \
      -c "lua vim.wait(2000)" -c "messages" -c "qa!" > /tmp/smoke.log 2>&1; \
    cat /tmp/smoke.log; \
    test ! -s /tmp/smoke.log && rm -rf /tmp/smoke

# ── serial autologin + kill the dev-ttyS0.device boot stall ──
RUN mkdir -p /etc/systemd/system/serial-getty@ttyS0.service.d && \
    printf '[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin root --noclear ttyS0 115200 linux\n' \
      > /etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf && \
    systemctl mask systemd-networkd-wait-online.service systemd-resolved.service 2>/dev/null || true
# ── sshd: root by key only ──
RUN mkdir -p /root/.ssh && chmod 700 /root/.ssh
COPY imgseed/authorized_keys /root/.ssh/authorized_keys
RUN chmod 600 /root/.ssh/authorized_keys && \
    printf 'PermitRootLogin prohibit-password\nPasswordAuthentication no\nUseDNS no\n' > /etc/ssh/sshd_config.d/golearn.conf && \
    systemctl enable ssh
# ── network: static IP from kernel cmdline gl.ip= ──
COPY rootfs-extra/glnet /usr/local/bin/glnet
COPY rootfs-extra/glnet.service /etc/systemd/system/glnet.service
RUN chmod +x /usr/local/bin/glnet && \
    ln -sf /etc/systemd/system/glnet.service /etc/systemd/system/sysinit.target.wants/glnet.service && \
    systemctl disable systemd-networkd 2>/dev/null || true
RUN systemctl enable docker || true
# ── iptables legacy (kernel raw table works with legacy) ──
RUN update-alternatives --set iptables /usr/sbin/iptables-legacy && update-alternatives --set ip6tables /usr/sbin/ip6tables-legacy
RUN echo "KUBECONFIG=/etc/rancher/k3s/k3s.yaml" >> /etc/environment
RUN echo tot-lab > /etc/hostname
# ── MOTD ──
RUN printf '\n  Welcome to your TOT lab environment!\n\n' > /etc/motd
